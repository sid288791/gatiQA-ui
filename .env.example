# Base URL of the gatiQA backend API. In dev, /api is proxied (see vite.config.ts).
VITE_API_BASE_URL=/api/v1

# Explicit development switch: serve synthetic fixtures instead of a real backend.
# NEVER enable in production builds.
VITE_USE_FIXTURES=false

# Optional bearer token attached to API requests (UI-side auth only).
# The UI never holds LLM keys or target-system credentials; those live server-side.
VITE_API_TOKEN=

# Base URL of the search API under test (mirrors search.api.base-url in
# gatiQA-test-api). Prefills the performance-test dialog's target URL.
VITE_SEARCH_API_BASE_URL=https://shop.advanceautoparts.com

# gatiQA-perf-api base URL. In dev, /perf-api is proxied to localhost:8082.
VITE_PERF_API_BASE_URL=/perf-api
